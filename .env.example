# Firebase configuration (used by GitHub Actions and local builds).
# Locally you can instead keep firebase-applet-config.json in the project root.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Set to "true" (or use `npm run dev:emulator`) to use the local Firebase emulators.
# VITE_USE_EMULATOR=true
