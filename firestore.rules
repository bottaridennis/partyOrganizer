rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helpers
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
             (
               request.auth.uid == "7LuDuLfoqXPs6sTq7jyRemsGkVm2" ||
               (request.auth.token.email in ["bottaridennis@gmail.com", "dennisbottari@gmail.com"] && request.auth.token.email_verified == true)
             );
    }

    function partyPath(partyId) {
      return /databases/$(database)/documents/parties/$(partyId);
    }

    function isMemberOfParty(partyId) {
      return isAuthenticated() &&
             (
               isSuperAdmin() ||
               (exists(partyPath(partyId)) &&
                (request.auth.uid in get(partyPath(partyId)).data.members ||
                 get(partyPath(partyId)).data.ownerUid == request.auth.uid))
             );
    }

    // Approved member: pending members can read but cannot change anything.
    // Members without a status entry predate the approval flow and count as active.
    function isActiveMember(partyId) {
      return isAuthenticated() &&
             (
               isSuperAdmin() ||
               (exists(partyPath(partyId)) &&
                (get(partyPath(partyId)).data.ownerUid == request.auth.uid ||
                 (request.auth.uid in get(partyPath(partyId)).data.members &&
                  get(partyPath(partyId)).data.get('memberStatus', {}).get(request.auth.uid, 'active') == 'active')))
             );
    }

    function isOrganizerOfParty(partyId) {
      return isAuthenticated() &&
             (
               isSuperAdmin() ||
               (exists(partyPath(partyId)) &&
                (get(partyPath(partyId)).data.ownerUid == request.auth.uid ||
                 (request.auth.uid in get(partyPath(partyId)).data.members &&
                  get(partyPath(partyId)).data.get('memberRoles', {}).get(request.auth.uid, '') == 'organizer')))
             );
    }

    // ===============================================================
    // Validators
    // ===============================================================

    function isValidUser(data, isCreate) {
      let baseValid = data.keys().hasAll(['uid', 'email']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() < 100 &&
             (!('partyId' in data) || data.partyId is string) &&
             (!('partyIds' in data) || data.partyIds is list);

      // Prevent self-escalation: the global role is informative only.
      let roleValid = !('role' in data) ||
                      (data.role == 'participant') ||
                      (isCreate == false && data.role == resource.data.role) ||
                      isSuperAdmin();

      return baseValid && roleValid;
    }

    function isValidParty(data) {
      return data.keys().hasAll(['name', 'inviteCode', 'ownerUid', 'members']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.inviteCode is string && data.inviteCode.size() == 6 &&
             data.ownerUid is string &&
             data.members is list && data.members.size() > 0 && data.members.size() < 200 &&
             data.ownerUid in data.members &&
             (!('memberRoles' in data) || data.memberRoles is map) &&
             (!('memberStatus' in data) || data.memberStatus is map);
    }

    // Only `uid` itself changes in memberRoles / memberStatus.
    function mapsTouchOnly(uid) {
      return request.resource.data.get('memberRoles', {}).diff(resource.data.get('memberRoles', {})).affectedKeys().hasOnly([uid]) &&
             request.resource.data.get('memberStatus', {}).diff(resource.data.get('memberStatus', {})).affectedKeys().hasOnly([uid]);
    }

    // A new user adds themselves as a pending participant (invite code flow).
    function isSelfJoin() {
      let uid = request.auth.uid;
      return !(uid in resource.data.members) &&
             request.resource.data.members.toSet() == resource.data.members.toSet().union([uid].toSet()) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberRoles', 'memberStatus']) &&
             mapsTouchOnly(uid) &&
             request.resource.data.memberRoles[uid] == 'participant' &&
             request.resource.data.memberStatus[uid] == 'pending';
    }

    // A member (not the owner) removes themselves.
    function isSelfLeave() {
      let uid = request.auth.uid;
      return uid in resource.data.members && uid != resource.data.ownerUid &&
             request.resource.data.members.toSet() == resource.data.members.toSet().difference([uid].toSet()) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberRoles', 'memberStatus']) &&
             !(uid in request.resource.data.get('memberRoles', {})) &&
             !(uid in request.resource.data.get('memberStatus', {}));
    }

    // Organizers (not only the owner) approve pending people...
    function isOrganizerApproval(partyId) {
      let changed = request.resource.data.get('memberStatus', {}).diff(resource.data.get('memberStatus', {})).affectedKeys();
      return isOrganizerOfParty(partyId) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberStatus']) &&
             !(resource.data.ownerUid in changed) &&
             changed.hasOnly(resource.data.members);
    }

    // ...and can remove one member at a time, never the owner. Roles stay owner-only.
    function isOrganizerRemoval(partyId) {
      let removed = resource.data.members.toSet().difference(request.resource.data.members.toSet());
      return isOrganizerOfParty(partyId) &&
             request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0 &&
             removed.size() == 1 &&
             !(resource.data.ownerUid in removed) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberRoles', 'memberStatus']) &&
             request.resource.data.get('memberRoles', {}).diff(resource.data.get('memberRoles', {})).affectedKeys().difference(removed).size() == 0 &&
             request.resource.data.get('memberStatus', {}).diff(resource.data.get('memberStatus', {})).affectedKeys().difference(removed).size() == 0;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['partyId', 'name', 'quantity', 'type', 'broughtBy']) &&
             data.partyId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.quantity is number && data.quantity >= 0 &&
             data.type in ['food', 'drink'] &&
             data.broughtBy is string &&
             (!('brand' in data) || data.brand is string) &&
             (!('price' in data) || (data.price is number && data.price >= 0)) &&
             (!('alcoholContent' in data) || data.alcoholContent is number) &&
             (!('fillLevel' in data) || data.fillLevel is number) &&
             (!('expiryDate' in data) || data.expiryDate is string) &&
             (!('labels' in data) || data.labels is list) &&
             (!('allergens' in data) || data.allergens is string) &&
             (!('imageUrl' in data) || data.imageUrl is string) &&
             (!('lastUpdated' in data) || data.lastUpdated is string) &&
             (!('updatedBy' in data) || (data.updatedBy == null || data.updatedBy is string)) &&
             (!('category' in data) || data.category is string);
    }

    function isCommon(broughtBy) {
      return broughtBy in ['common', 'Comune', ''];
    }

    function isValidParticipant(data) {
      return data.keys().hasAll(['partyId', 'name', 'createdAt']) &&
             data.partyId is string &&
             (!('uid' in data) || data.uid is string) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             (!('surname' in data) || (data.surname is string && data.surname.size() < 100)) &&
             (!('group' in data) || (data.group is string && data.group.size() < 100)) &&
             (!('role' in data) || (data.role is string && data.role.size() < 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() < 100)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() < 1000));
    }

    function isValidDictionaryItem(data) {
      return data.keys().hasAll(['partyId', 'name']) &&
             data.partyId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100;
    }

    function isValidLog(data) {
      return data.keys().hasAll(['partyId', 'date', 'description', 'organizer']) &&
             data.partyId is string &&
             data.date is string &&
             data.description is string && data.description.size() > 0 && data.description.size() < 1000 &&
             data.organizer is string && data.organizer.size() > 0 && data.organizer.size() < 100 &&
             (!('participantId' in data) || data.participantId is string);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['partyId', 'timestamp', 'action', 'entityType', 'entityId', 'entityName', 'userId', 'userName', 'details']) &&
             data.partyId is string &&
             data.timestamp is string &&
             data.action in ['create', 'update', 'delete', 'move', 'auth'] &&
             data.entityType in ['product', 'participant', 'party', 'category', 'group', 'role', 'log'] &&
             data.entityId is string &&
             data.entityName is string &&
             data.userId == request.auth.uid &&
             data.userName is string &&
             data.details is string;
    }

    function isValidRequest(data) {
      return data.keys().hasAll(['partyId', 'userId', 'userName', 'productId', 'productName', 'quantity', 'type', 'status', 'createdAt']) &&
             data.partyId is string &&
             data.userId is string &&
             data.userName is string &&
             data.productId is string &&
             data.productName is string &&
             data.quantity is number && data.quantity > 0 &&
             data.type in ['withdraw', 'return'] &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.createdAt is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /test/connection {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data, true);
      allow update: if isOwner(userId) && isValidUser(request.resource.data, false);
    }

    match /parties/{partyId} {
      // Listing is needed to look a party up by invite code.
      allow get, list: if isAuthenticated();

      allow create: if isAuthenticated() &&
                    isValidParty(request.resource.data) &&
                    request.resource.data.ownerUid == request.auth.uid &&
                    request.resource.data.members == [request.auth.uid];

      allow update: if isAuthenticated() &&
                    isValidParty(request.resource.data) &&
                    request.resource.data.ownerUid == resource.data.ownerUid &&
                    (
                      request.auth.uid == resource.data.ownerUid ||
                      isSuperAdmin() ||
                      isSelfJoin() ||
                      isSelfLeave() ||
                      isOrganizerApproval(partyId) ||
                      isOrganizerRemoval(partyId)
                    );

      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.ownerUid || isSuperAdmin());
    }

    match /products/{productId} {
      allow read: if isMemberOfParty(resource.data.partyId);

      // Participants may only add products they bring themselves or shared ones.
      allow create: if isActiveMember(request.resource.data.partyId) &&
                      isValidProduct(request.resource.data) &&
                      (isOrganizerOfParty(request.resource.data.partyId) ||
                       request.resource.data.broughtBy == request.auth.uid ||
                       isCommon(request.resource.data.broughtBy));

      allow update: if isActiveMember(resource.data.partyId) &&
                    isValidProduct(request.resource.data) &&
                    request.resource.data.partyId == resource.data.partyId &&
                    (isOrganizerOfParty(resource.data.partyId) ||
                     (resource.data.broughtBy == request.auth.uid &&
                      (request.resource.data.broughtBy == request.auth.uid || isCommon(request.resource.data.broughtBy))));

      allow delete: if isOrganizerOfParty(resource.data.partyId);
    }

    match /pantry_logs/{logId} {
      allow read: if isMemberOfParty(resource.data.partyId);
      allow create: if isOrganizerOfParty(request.resource.data.partyId) && isValidLog(request.resource.data);
      allow update, delete: if isOrganizerOfParty(resource.data.partyId);
    }

    match /participants/{participantId} {
      allow read: if isMemberOfParty(resource.data.partyId);

      // Guests are created by organizers; members create their own record when joining.
      allow create: if isValidParticipant(request.resource.data) &&
                      (isOrganizerOfParty(request.resource.data.partyId) ||
                       (request.resource.data.uid == request.auth.uid &&
                        participantId == 'member-' + request.resource.data.partyId + '-' + request.auth.uid &&
                        // getAfter: the join batch adds the user to the party in the same write.
                        exists(partyPath(request.resource.data.partyId)) &&
                        request.auth.uid in getAfter(partyPath(request.resource.data.partyId)).data.members));

      allow update: if isValidParticipant(request.resource.data) &&
                    request.resource.data.partyId == resource.data.partyId &&
                    request.resource.data.get('uid', '') == resource.data.get('uid', '') &&
                    (isOrganizerOfParty(resource.data.partyId) ||
                     (resource.data.get('uid', '') == request.auth.uid && isMemberOfParty(resource.data.partyId)));

      // Members remove their own record when they leave.
      allow delete: if isOrganizerOfParty(resource.data.partyId) ||
                      (isAuthenticated() && resource.data.get('uid', '') == request.auth.uid);
    }

    match /categories/{id} {
      allow read: if isMemberOfParty(resource.data.partyId);
      allow create, update: if isOrganizerOfParty(request.resource.data.partyId) && isValidDictionaryItem(request.resource.data);
      allow delete: if isOrganizerOfParty(resource.data.partyId);
    }

    match /groups/{id} {
      allow read: if isMemberOfParty(resource.data.partyId);
      allow create, update: if isOrganizerOfParty(request.resource.data.partyId) && isValidDictionaryItem(request.resource.data);
      allow delete: if isOrganizerOfParty(resource.data.partyId);
    }

    match /participant_roles/{id} {
      allow read: if isMemberOfParty(resource.data.partyId);
      allow create, update: if isOrganizerOfParty(request.resource.data.partyId) && isValidDictionaryItem(request.resource.data);
      allow delete: if isOrganizerOfParty(resource.data.partyId);
    }

    match /audit_logs/{logId} {
      allow read: if isOrganizerOfParty(resource.data.partyId);
      allow create: if isActiveMember(request.resource.data.partyId) && isValidAuditLog(request.resource.data);
      allow update, delete: if false;
    }

    match /product_requests/{requestId} {
      allow read: if isMemberOfParty(resource.data.partyId);
      allow create: if isActiveMember(request.resource.data.partyId) &&
                      isValidRequest(request.resource.data) &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.status == 'pending';
      allow update: if isOrganizerOfParty(resource.data.partyId) && isValidRequest(request.resource.data);
      // Organizers clean up; authors withdraw a request that is still pending.
      allow delete: if isOrganizerOfParty(resource.data.partyId) ||
                      (isOwner(resource.data.userId) && resource.data.status == 'pending');
    }
  }
}
